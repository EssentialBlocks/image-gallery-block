# Files and folders excluded from the production/WordPress.org ZIP.
# Everything the plugin needs at runtime — image-gallery-block.php, block.json,
# readme.txt, includes/, dist/ (minus source maps) and lib/ — must stay OUT of this list.

# --- Version control ---
# `**/` variants matter: submodules carry a `.git` *file* (a gitdir pointer),
# which a bare top-level `.git` pattern does not catch.
.git
**/.git
.gitignore
**/.gitignore
.gitattributes
**/.gitattributes
.gitmodules
.github
.gitlab-ci.yml

# --- Editor / OS cruft ---
.editorconfig
.idea
.vscode
.DS_Store
**/.DS_Store
Thumbs.db

# --- Build tooling config ---
.babelrc
.babelrc.js
.babelrc.json
babel.config.js
babel.config.json
webpack.config.js
Gruntfile.js
gulpfile.js
postcss.config.js
tsconfig.json
config

# --- Package managers ---
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
composer.json
composer.lock
node_modules
node_modules/**/*.*
vendor

# --- Source (compiled into dist/) ---
src
controls
lib/style-handler/style-handler.js
lib/style-handler/helpers.js

# Stale wp-scripts default output. webpack.config.js emits to dist/,
# and nothing in the plugin references build/.
build

# Source maps — ~3.5MB of the 4.6MB dist/ folder, dev-only.
*.map

# --- Linting / testing / CI ---
.eslintignore
.eslintrc
.eslintrc.js
.prettierrc
.phpcs.xml
.phpcs.xml.dist
phpcs.xml
phpcs.xml.dist
phpunit.xml
phpunit.xml.dist
multisite.xml
multisite.xml.dist
behat.yml
tests
bin
.travis.yml
.circleci/config.yml
bitbucket-pipelines.yml
dependencies.yml

# --- Deploy / docs / release artifacts ---
.deployignore
.distignore
.wordpress-org
wp-cli.local.yml
README.md
compatibility-report.md
*.sql
*.tar.gz
*.zip
